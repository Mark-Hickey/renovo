{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "renovo baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "renovo watch",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
